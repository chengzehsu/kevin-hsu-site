# Cloudflare static-assets response headers (ignored by other hosts).

# The Open Graph images are exported without an extension; crawlers need the real type.
/opengraph-image
  Content-Type: image/png
/en/opengraph-image
  Content-Type: image/png

# Hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Baseline protection on every response. The CSP leaves scripts unrestricted on purpose: Next writes page data into
# inline scripts that differ on every page, so hashes would have to be generated per page, and 'unsafe-inline' would
# not stop inline injection anyway. These four limits block framing and base-tag injection at no risk of breaking a page.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
