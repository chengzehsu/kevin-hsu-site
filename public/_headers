# Cloudflare static-assets response headers (ignored by other hosts).

# The Open Graph images are exported without an extension; crawlers need the real type.
/opengraph-image
  Content-Type: image/png
/en/opengraph-image
  Content-Type: image/png

# Hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Baseline protection on every response. No CSP yet: the theme, language, and analytics scripts are inline.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
