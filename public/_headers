# Cloudflare Pages response headers (ignored by other hosts).

# The Open Graph images are exported without an extension; crawlers need the real type.
/opengraph-image
  Content-Type: image/png
/en/opengraph-image
  Content-Type: image/png

# Hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
